generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IntegrationConfig {
  id                   String   @id @default("whmcs")
  endpoint             String
  encryptedCredentials String   @db.Text
  updatedAt            DateTime @updatedAt
}

model AdminAudit {
  id        String   @id @default(cuid())
  action    String
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

/// Ajustes públicos del sitio (contacto, redes, contenido, visibilidad, apariencia).
/// Claves esperadas: whmcs, theme, network_status, contact, social, content, visibility, appearance.
/// Aplicar con: npx prisma migrate deploy (o db push en desarrollo). No ejecutar en remoto desde CI de este PR.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Catálogo público editable (planes/ubicaciones). JSON validado en servidor.
/// Aplicar con prisma migrate deploy. Independiente de SiteSetting.
model CatalogConfig {
  id        String   @id @default("default")
  payload   Json
  updatedAt DateTime @updatedAt
}

/// Textos públicos editables por ruta (CMS estructurado).
/// payload = Record<fieldId, string>. Defaults en lib/page-content.ts.
/// Aplicar: npx prisma migrate deploy
model PageContent {
  path      String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

/// Pedidos de hosting creados desde la web (checkout propio).
/// El pago se confirma por el admin o por webhook (PAYMENT_WEBHOOK_SECRET);
/// al confirmarse, el aprovisionamiento crea la cuenta cPanel en WHM
/// automáticamente (lib/provisioning.ts). Sin proveedor de pago conectado
/// todavía: la confirmación manual del admin es la vía activa.
/// status: pending_payment | paid | provisioning | active | provision_failed | cancelled
/// Aplicar: npx prisma migrate deploy
model Order {
  id                String          @id @default(cuid())
  number            String          @unique
  lookupToken       String          @unique @default(cuid())
  customerName      String
  customerEmail     String
  domain            String
  planId            String
  planName          String
  planCategory      String          @default("web")
  price             String
  status            String          @default("pending_payment")
  paymentRef        String?
  paidAt            DateTime?
  paidVia           String?
  whmUsername       String?         @unique
  whmPackage        String?
  provisionAttempts Int             @default(0)
  provisionError    String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  hostingAccount    HostingAccount?

  @@index([customerEmail, createdAt])
  @@index([status, createdAt])
}

/// Cuenta cPanel creada en WHM para un pedido. La contraseña se guarda
/// cifrada (AES-256-GCM, lib/provisioning.ts) y solo se muestra al admin.
model HostingAccount {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id])
  whmUsername       String   @unique
  domain            String
  package           String
  /// active | suspended
  status            String   @default("active")
  encryptedPassword String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

