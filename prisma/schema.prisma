generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IntegrationConfig {
  id                   String   @id @default("whmcs")
  endpoint             String
  encryptedCredentials String   @db.Text
  updatedAt            DateTime @updatedAt
}

model AdminAudit {
  id        String   @id @default(cuid())
  action    String
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

/// Intentos de login compartidos por todas las instancias. La clave es un HMAC, no la IP.
model LoginThrottle {
  id          String   @id
  failures    Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

/// Límite de peticiones públicas (contacto, consulta de dominios) compartido por todas
/// las instancias. La clave es un HMAC de ámbito + IP, nunca la IP en claro.
/// Si la tabla no existe, la ruta pública se rechaza: no hay modo sin límite.
model RequestThrottle {
  id          String   @id
  hits        Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

/// Mensajes recibidos por los formularios propios (contacto y abuso).
/// `delivered` dice si el correo de aviso salió; un falso no invalida el mensaje guardado.
model ContactMessage {
  id        String   @id @default(cuid())
  kind      String
  name      String
  email     String
  topic     String
  target    String?
  body      String   @db.Text
  status    String
  delivered Boolean  @default(false)
  clientKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// Alta automática en WHM. Desactivada por defecto: sin `enabled` y sin paquete
/// no se llama a WHM. Las credenciales de escritura viven aparte, cifradas,
/// en IntegrationConfig("whm-provision").
model ProvisionSetting {
  id          String   @id @default("whm")
  enabled     Boolean  @default(false)
  /// Paquete WHM por defecto para los planes de hosting.
  packageName String   @default("")
  /// Paquete por plan: { planId: "paquete" }. Si falta uno, se usa packageName.
  packageByPlan Json?
  updatedAt   DateTime @updatedAt
}

/// Ajustes públicos del sitio (contacto, redes, contenido, visibilidad, apariencia).
/// Claves esperadas: whmcs, theme, network_status, contact, social, content, visibility, appearance.
/// Aplicar con: npx prisma migrate deploy (o db push en desarrollo). No ejecutar en remoto desde CI de este PR.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Catálogo público editable (planes/ubicaciones). JSON validado en servidor.
/// Aplicar con prisma migrate deploy. Independiente de SiteSetting.
model CatalogConfig {
  id        String   @id @default("default")
  payload   Json
  updatedAt DateTime @updatedAt
}

/// Textos públicos editables por ruta (CMS estructurado).
/// payload = Record<fieldId, string>. Defaults en lib/page-content.ts.
/// Aplicar: npx prisma migrate deploy
model PageContent {
  path      String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        CustomerOrder[]
  tickets       SupportTicket[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model CustomerOrder {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey  String
  planId          String
  planName        String
  /// Dominio que el cliente declara para el servicio. Obligatorio para el alta
  /// automática de hosting; nulo en pedidos anteriores y en planes sin cPanel.
  domain          String?
  currency        String
  totalCents      Int
  status          String
  createdAt       DateTime @default(now())
  lines           OrderLine[]
  invoice         CustomerInvoice?
  service         CustomerService?

  @@unique([idempotencyKey])
  @@index([userId])
}

model OrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planId      String
  description String
  quantity    Int
  unitCents   Int
  totalCents  Int
}

model CustomerInvoice {
  id         String   @id @default(cuid())
  userId     String
  orderId    String   @unique
  order      CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  number     String   @unique
  currency   String
  subtotalCents Int
  taxMode    String
  taxCents   Int?
  totalCents Int
  status     String
  createdAt  DateTime @default(now())
  lines      InvoiceLine[]
  payment    Payment?
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitCents   Int
  totalCents  Int
}

/// Un cobro por factura, sea manual o de una pasarela. La tabla conserva el nombre
/// `ManualPayment` para no romper las migraciones ya aplicadas.
/// `provider` = "manual" | "paypal". `providerRef` es el identificador de captura
/// de la pasarela y es único: es lo que hace idempotente el webhook.
model Payment {
  id          String          @id @default(cuid())
  invoiceId   String          @unique
  invoice     CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  currency    String
  amountCents Int
  status      String
  note        String
  actor       String
  provider    String          @default("manual")
  providerRef String?         @unique
  createdAt   DateTime        @default(now())

  @@map("ManualPayment")
}

/// `status`: pending_provision | provisioning | active | cancelled.
/// `provisioning` es un cerrojo: lo toma una sola llamada y evita dos altas en WHM.
model CustomerService {
  id                String        @id @default(cuid())
  userId            String
  orderId           String        @unique
  order             CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  planId            String
  planName          String
  status            String
  note              String
  /// Usuario cPanel creado en WHM. Si existe, el alta ya ocurrió y no se repite.
  cpanelUser        String?       @unique
  provisionedAt     DateTime?
  provisionAttempts Int           @default(0)
  /// Último motivo de fallo, ya saneado. Nunca contraseñas ni tokens.
  provisionError    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime      @default(now())
}

model CommerceEvent {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entityId  String?
  details   String
  createdAt DateTime @default(now())
}

