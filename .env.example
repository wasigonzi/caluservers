DATABASE_URL="postgresql://user:password@localhost:5432/caluservers?schema=public"
# Supabase IPv4: prefer Session pooler (no inventar password; copiar desde Dashboard → Database → Connection string → Session mode):
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct db.<ref>.supabase.co:5432 often needs IPv6; TCP open ≠ Postgres auth OK.
# If Prisma P1001 or REST "Invalid API key", fix creds — CMS will refuse saves (503), not fake success.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="GENERATE_WITH_npm_run_admin:hash"
AUTH_SECRET="64_random_hex_characters_minimum_32"
# Opcional. Si se define, el login exige un código TOTP de 6 dígitos.
# Generar con: npm run admin:totp
# Déjalo vacío para no cambiar instalaciones que aún no activan MFA.
# El límite de intentos vive en Postgres (LoginThrottle), no en la memoria del proceso.
# ADMIN_TOTP_SECRET=""
SETTINGS_ENCRYPTION_KEY="64_random_hex_characters"
WHMCS_ALLOWED_HOST="client.caluservers.com"

# Vercel Blob (subida de logos/favicon/OG en /admin/site)
# Crear un Blob store en el proyecto Vercel (Storage → Blob, acceso Public)
# y conectar el proyecto. Luego: vercel env pull
# No creamos el store desde este PR. Sin token, la UI desactiva la subida
# y permite pegar URLs https.
BLOB_READ_WRITE_TOKEN=""
# Opcional con OIDC en Vercel: BLOB_STORE_ID se inyecta al conectar el store
# BLOB_STORE_ID=""

# URL canónica pública (robots/sitemap/OG). Sin barra final.
NEXT_PUBLIC_SITE_URL="https://caluservers.com"

# Supabase (Postgres vía DATABASE_URL; URL/publishable opcionales para cliente)
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Área propia de clientes. Sin BETTER_AUTH_SECRET el registro responde 503.
# BETTER_AUTH_SECRET="32_o_mas_caracteres_aleatorios"
# BETTER_AUTH_URL="https://caluservers.com"
# BILLING_CURRENCY no está decidida. Sin ella no hay pedidos.
# TAX_MODE=none solo si el propietario confirma que no hay impuesto.
# SMTP_URL y MAIL_FROM envían verificación y recuperación. Sin SMTP no se revela el enlace.
# MAIL_SINK_DIR solo funciona fuera de producción.

# Formulario propio de contacto y abuso (/contact, /abuse).
# El mensaje se guarda siempre en la base y se ve en /admin/mensajes.
# El aviso por correo usa, por este orden: el email de contacto de /admin/site,
# y si no está, CONTACT_INBOX. Sin SMTP_URL no sale ningún aviso, pero el
# mensaje no se pierde.
# CONTACT_INBOX="ventas@caluservers.com"

# Cobro con PayPal (Orders API v2). Sin estas variables, /cuenta no ofrece pago
# en línea y el cobro sigue siendo manual y auditado desde /admin/comercio.
# PAYPAL_ENV debe ser sandbox o live. Las claves salen de developer.paypal.com
# → Apps & Credentials, en el mismo entorno que PAYPAL_ENV.
# PAYPAL_ENV="sandbox"
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# Id del webhook creado en esa misma app, apuntando a
# https://TU-DOMINIO/api/paypal/webhook con los eventos
# PAYMENT.CAPTURE.COMPLETED y CHECKOUT.ORDER.COMPLETED.
# Sin él, el webhook responde 503: no se acepta un aviso sin verificar la firma.
# PAYPAL_WEBHOOK_ID=""
# NEXT_PUBLIC_SITE_URL es obligatoria para el retorno del pago.

# Alta automática en WHM: no usa variables de entorno. Se configura en
# /admin/provision con un token WHM distinto, con ACL createacct, y exige
# SMTP_URL porque la contraseña inicial no se guarda: solo se envía al cliente.

# Búsqueda de dominios: no necesita credenciales. Consulta RDAP al registro
# oficial de cada extensión usando el arranque público de IANA.

# Tras clonar: npx prisma migrate deploy
# Incluye LoginThrottle, el área propia de clientes, los formularios propios,
# el cobro por pasarela y el alta automática.
