DATABASE_URL="postgresql://user:password@localhost:5432/caluservers?schema=public"
# Supabase IPv4: prefer Session pooler (no inventar password; copiar desde Dashboard → Database → Connection string → Session mode):
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct db.<ref>.supabase.co:5432 often needs IPv6; TCP open ≠ Postgres auth OK.
# If Prisma P1001 or REST "Invalid API key", fix creds — CMS will refuse saves (503), not fake success.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="GENERATE_WITH_npm_run_admin:hash"
AUTH_SECRET="64_random_hex_characters_minimum_32"
SETTINGS_ENCRYPTION_KEY="64_random_hex_characters"
WHMCS_ALLOWED_HOST="client.caluservers.com"

# Vercel Blob (subida de logos/favicon/OG en /admin/site)
# Crear un Blob store en el proyecto Vercel (Storage → Blob, acceso Public)
# y conectar el proyecto. Luego: vercel env pull
# No creamos el store desde este PR. Sin token, la UI desactiva la subida
# y permite pegar URLs https.
BLOB_READ_WRITE_TOKEN=""
# Opcional con OIDC en Vercel: BLOB_STORE_ID se inyecta al conectar el store
# BLOB_STORE_ID=""

# URL canónica pública (robots/sitemap/OG). Sin barra final.
NEXT_PUBLIC_SITE_URL="https://caluservers.com"

# Supabase (Postgres vía DATABASE_URL; URL/publishable opcionales para cliente)
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Tras clonar: npx prisma migrate deploy  (SiteSetting, CatalogConfig, PageContent)
