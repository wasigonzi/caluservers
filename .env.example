DATABASE_URL="postgresql://user:password@localhost:5432/caluservers?schema=public"
# Supabase IPv4: prefer Session pooler (no inventar password; copiar desde Dashboard → Database → Connection string → Session mode):
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct db.<ref>.supabase.co:5432 often needs IPv6; TCP open ≠ Postgres auth OK.
# If Prisma P1001 or REST "Invalid API key", fix creds — CMS will refuse saves (503), not fake success.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="GENERATE_WITH_npm_run_admin:hash"
# Argon2id (Fase 1, tramo B): parámetros OWASP por defecto. Sin valores, el
# código usa memoria 19 MiB, t=2, p=1 y salida de 32 bytes. Solo se cambian
# si el despliegue no puede pagar 19 MiB por verificación de contraseña.
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME=2
# ARGON2_PARALLELISM=1
AUTH_SECRET="64_random_hex_characters_minimum_32"
# Opcional. Si se define, el login exige un código TOTP de 6 dígitos.
# Generar con: npm run admin:totp
# Déjalo vacío para no cambiar instalaciones que aún no activan MFA.
# El límite de intentos vive en Postgres (LoginThrottle), no en la memoria del proceso.
# ADMIN_TOTP_SECRET=""
# MFA obligatorio (Fase 0): con ADMIN_MFA_REQUIRED=true el login de admin se
# bloquea si no hay ningún método MFA enrolado (hoy solo TOTP; las passkeys
# llegan en Fase 1). Sin esta bandera, el MFA sigue siendo opcional.
# ADMIN_MFA_REQUIRED=true
SETTINGS_ENCRYPTION_KEY="64_random_hex_characters"
WHMCS_ALLOWED_HOST="client.caluservers.com"

# Vercel Blob (subida de logos/favicon/OG en /admin/site)
# Crear un Blob store en el proyecto Vercel (Storage → Blob, acceso Public)
# y conectar el proyecto. Luego: vercel env pull
# No creamos el store desde este PR. Sin token, la UI desactiva la subida
# y permite pegar URLs https.
BLOB_READ_WRITE_TOKEN=""
# Opcional con OIDC en Vercel: BLOB_STORE_ID se inyecta al conectar el store
# BLOB_STORE_ID=""

# URL canónica pública (robots/sitemap/OG). Sin barra final.
NEXT_PUBLIC_SITE_URL="https://caluservers.com"

# Supabase (Postgres vía DATABASE_URL; URL/publishable opcionales para cliente)
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Área propia de clientes. Sin BETTER_AUTH_SECRET el registro responde 503.
# BETTER_AUTH_SECRET="32_o_mas_caracteres_aleatorios"
# BETTER_AUTH_URL="https://caluservers.com"
# WebAuthn/passkeys (Fase 1, tramo C). Sin valores se derivan de BETTER_AUTH_URL:
# RP ID = su host, RP name = CaluServers, origin = la URL misma. En local
# quedan localhost / http://localhost:3000. El RP ID definitivo es el
# dominio de producción: las passkeys registradas con un RP ID no valen en
# otro dominio. Se usa el mismo RP para el admin (lib/webauthn.ts) y para
# el cliente (plugin @better-auth/passkey).
# WEBAUTHN_RP_ID=""
# WEBAUTHN_RP_NAME=CaluServers
# WEBAUTHN_ORIGIN=""
# BILLING_CURRENCY no está decidida. Sin ella no hay pedidos.
# TAX_MODE=none solo si el propietario confirma que no hay impuesto.
# SMTP_URL y MAIL_FROM envían recuperación de contraseña y avisos
# (credenciales del alta en WHM, contacto, tickets). Sin SMTP no se envía
# ningún correo. No hay verificación de correo: el cliente contrata al registrarse.
# MAIL_SINK_DIR solo funciona fuera de producción.

# Adjuntos de ticket (Fase 5, frente C). Sin esta variable la subida se
# rechaza y no se guarda nada. En producción el directorio debe existir;
# fuera de producción se crea si hace falta. Nunca dentro del repo.
# TICKET_ATTACHMENTS_DIR="/var/lib/caluservers/ticket-attachments"

# Formulario propio de contacto y abuso (/contact, /abuse).
# El mensaje se guarda siempre en la base y se ve en /admin/mensajes.
# El aviso por correo usa, por este orden: el email de contacto de /admin/site,
# y si no está, CONTACT_INBOX. Sin SMTP_URL no sale ningún aviso, pero el
# mensaje no se pierde.
# CONTACT_INBOX="ventas@caluservers.com"

# Cobro con PayPal (Orders API v2). Sin estas variables, /cuenta no ofrece pago
# en línea y el cobro sigue siendo manual y auditado desde /admin/facturas.
# PAYPAL_ENV debe ser sandbox o live. Las claves salen de developer.paypal.com
# → Apps & Credentials, en el mismo entorno que PAYPAL_ENV.
# PAYPAL_ENV="sandbox"
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# Id del webhook creado en esa misma app, apuntando a
# https://TU-DOMINIO/api/paypal/webhook con los eventos
# PAYMENT.CAPTURE.COMPLETED y CHECKOUT.ORDER.COMPLETED.
# Sin él, el webhook responde 503: no se acepta un aviso sin verificar la firma.
# PAYPAL_WEBHOOK_ID=""
# NEXT_PUBLIC_SITE_URL es obligatoria para el retorno del pago.

# Cobro con Stripe (Checkout). Sin estas variables, /cuenta no ofrece Stripe
# y el cobro sigue siendo manual o por PayPal. Las claves salen de
# dashboard.stripe.com → Developers → API keys, en el mismo modo (test/live)
# que la clave. Usa las claves de test hasta probar el cobro de punta a punta.
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# Secreto del webhook creado en esa misma cuenta, apuntando a
# https://TU-DOMINIO/api/stripe/webhook con los eventos
# checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted y
# charge.refunded. Sin él, el webhook responde 503: no se acepta un aviso
# sin verificar la firma. Las claves también se pueden guardar en el plugin
# `stripe` desde /admin/plugins en vez de en variables de entorno.
# STRIPE_WEBHOOK_SECRET=""

# Alta automática en WHM: no usa variables de entorno. Se configura en
# /admin/provision con un token WHM distinto, con ACL createacct.
# SMTP_URL es opcional: sin él el alta se hace igual y la contraseña inicial
# (determinista, no se guarda) queda visible en el panel del cliente y en el
# de administración; con SMTP, además, se envía por correo.

# Búsqueda de dominios: no necesita credenciales. Consulta RDAP al registro
# oficial de cada extensión usando el arranque público de IANA.

# Tras clonar: npx prisma migrate deploy
# Incluye LoginThrottle, el área propia de clientes, los formularios propios,
# el cobro por pasarela y el alta automática.

# Paneles Plesk y DirectAdmin (Fase 4, frente B). Doble cerrojo: el
# adaptador solo funciona si la variable está en true Y el plugin está
# activado en /admin/plugins Y tiene credenciales guardadas. Por defecto
# false: sin la variable, las operaciones responden 503 aunque el plugin
# esté activo. Ver docs/PANELES.md.
# PLESK_ENABLED=false
# DIRECTADMIN_ENABLED=false

# Cron de facturación recurrente (Fase 2, frente C). Sin CRON_SECRET, las
# rutas /api/cron/billing y /api/cron/renewals responden 503: el cron no
# corre. Generar con: openssl rand -hex 32. El mismo valor va en Vercel
# (variables de entorno) para que el cron de Vercel pueda llamarlas, y
# nunca se publica ni se devuelve en ninguna respuesta.
# CRON_SECRET=""
# Dunning día 30: con true, el cron cancela la suscripción y el servicio
# tras 30 días impago. Por defecto false: el dunning se detiene en la
# suspensión (día 14) y la terminación queda registrada como omitida.
DUNNING_TERMINATE_ENABLED=false

# Respaldos (Fase 6, frente C). Sin valores: todo comentado y vacío.
# BACKUP_AGE_PUBLIC_KEY cifra el volcado con `age` (scripts/backup.mjs);
# sin ella, el respaldo queda SIN cifrar y el script lo avisa. Generar con:
# age-keygen -o age-identity.txt (la clave pública es la línea age1...).
# BACKUP_AGE_PUBLIC_KEY=""
# BACKUP_AGE_PRIVATE_KEY es la clave privada (AGE-SECRET-KEY-...) o la ruta
# al archivo de identidad; solo la usa scripts/restore.mjs. Nunca en el repo.
# BACKUP_AGE_PRIVATE_KEY=""
# Bucket S3-compatible para subir el respaldo. Las 4 o ninguna: sin ellas,
# el respaldo queda solo en local y no se sube nada.
# BACKUP_S3_ENDPOINT=""
# BACKUP_S3_BUCKET=""
# BACKUP_S3_ACCESS_KEY=""
# BACKUP_S3_SECRET_KEY=""
# Región para la firma SigV4 (por defecto us-east-1).
# BACKUP_S3_REGION=""
