DATABASE_URL="postgresql://user:password@localhost:5432/caluservers?schema=public"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="GENERATE_WITH_npm_run_admin:hash"
AUTH_SECRET="64_random_hex_characters_minimum_32"
SETTINGS_ENCRYPTION_KEY="64_random_hex_characters"
WHMCS_ALLOWED_HOST="client.caluservers.com"

# Vercel Blob (subida de logos/favicon/OG en /admin/site)
# Crear un Blob store en el proyecto Vercel (Storage → Blob, acceso Public)
# y conectar el proyecto. Luego: vercel env pull
# No creamos el store desde este PR. Sin token, la UI desactiva la subida
# y permite pegar URLs https.
BLOB_READ_WRITE_TOKEN=""
# Opcional con OIDC en Vercel: BLOB_STORE_ID se inyecta al conectar el store
# BLOB_STORE_ID=""
